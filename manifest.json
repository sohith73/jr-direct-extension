{
  "manifest_version": 3,
  "name": "FlashFire JR + Indeed + Reed + Flexa → Dashboard Direct",
  "version": "1.31.1.0",
  "description": "Scrape jobright.ai, Indeed, Reed (reed.co.uk) AND Flexa (flexa.careers) job listings from the DOM as you scroll, AI-judge in-extension against the client summary, and push picks straight to the FlashFire dashboard.",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": [
    "https://jobright.ai/*",
    "https://*.jobright.ai/*",
    "https://*.indeed.com/*",
    "https://indeed.com/*",
    "https://*.reed.co.uk/*",
    "https://reed.co.uk/*",
    "https://flexa.careers/*",
    "https://*.flexa.careers/*",
    "https://api.openai.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Toggle FlashFire Panel (JR + Indeed + Reed + Flexa)"
  },
  "content_scripts": [
    {
      "matches": ["https://jobright.ai/*", "https://*.jobright.ai/*"],
      "js": ["content-inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://jobright.ai/*", "https://*.jobright.ai/*"],
      "js": ["content-scrape.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.indeed.com/*", "https://indeed.com/*"],
      "js": ["content-scrape-indeed.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://*.reed.co.uk/*", "https://reed.co.uk/*"],
      "js": ["content-scrape-reed.js"],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": ["https://flexa.careers/*", "https://*.flexa.careers/*"],
      "js": ["content-scrape-flexa.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["sidepanel.html", "sidepanel.js", "sidepanel.css"],
      "matches": [
        "https://jobright.ai/*",
        "https://*.jobright.ai/*",
        "https://*.indeed.com/*",
        "https://indeed.com/*",
        "https://*.reed.co.uk/*",
        "https://reed.co.uk/*",
        "https://flexa.careers/*",
        "https://*.flexa.careers/*"
      ]
    }
  ]
}
